# ─── Database ────────────────────────────────────────────────────────────────
# Local: docker compose up -d  (Postgres ở port 5433 để không đụng container khác)
DATABASE_URL="postgresql://expense:expense@localhost:5433/expense_tracker?schema=public"
# Chỉ cần khi dùng Neon: DATABASE_URL là pooled (-pooler), DIRECT_URL là direct.
# DIRECT_URL="postgresql://...neon.tech/expense_tracker?sslmode=require"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Sinh bằng: openssl rand -base64 48
JWT_ACCESS_SECRET="thay-bang-secret-that"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT="3001"
NODE_ENV="development"
# Origin của FE, dùng cho CORS credentials. Nhiều origin thì phân tách bằng dấu phẩy.
WEB_ORIGIN="http://localhost:3000"

# ─── Rate limit ──────────────────────────────────────────────────────────────
# Giới hạn cho /auth/login và /auth/register. 10/phút là mức cho production.
# Bộ e2e nâng giá trị này lên (xem apps/api/test/run-all.sh) vì chạy nhiều suite
# liên tiếp sẽ vấp giới hạn thật.
AUTH_THROTTLE_LIMIT="10"
AUTH_THROTTLE_TTL_MS="60000"

# ─── Import ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES="4194304"
MAX_IMPORT_ROWS="10000"
