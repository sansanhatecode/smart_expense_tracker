// Prisma 7: generator `prisma-client`, `output` bắt buộc, url nằm ở prisma.config.ts.
// moduleFormat = "cjs" vì NestJS build ra CommonJS.

// output nằm TRONG src/ là có chủ ý: nếu để ngoài, tsc tính rootDir là apps/api
// và sinh ra dist/src/main.js, làm `node dist/main.js` hỏng.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts      Account[]
  categories    Category[]
  categoryRules CategoryRule[]
  transactions  Transaction[]
  budgets       Budget[]
  importBatches ImportBatch[]
  refreshTokens RefreshToken[]
}

/// Refresh token rotation có reuse detection.
///
/// Mỗi lần login mở một "family". Refresh thành công thì token cũ bị revoke và
/// trỏ `replacedById` sang token mới. Nếu một token ĐÃ revoke được dùng lại →
/// coi như token bị đánh cắp → revoke toàn bộ family, buộc login lại.
///
/// Chỉ lưu sha256 của token, không bao giờ lưu token gốc.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @unique
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Danh mục
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      TxType
  icon      String   @default("Tag")
  /// #RRGGBB — dùng trực tiếp làm màu series trong chart
  color     String   @default("#64748b")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       Transaction[]
  stagedTransactions StagedTransaction[]
  budgets            Budget[]
  rules              CategoryRule[]

  @@unique([userId, name, type])
  @@index([userId])
}

/// Rule auto-categorize theo keyword. `priority` cao hơn thắng khi nhiều rule khớp.
model CategoryRule {
  id         String   @id @default(cuid())
  userId     String
  /// Keyword đã uppercase, so khớp bằng "contains" trên description đã normalize
  keyword    String
  categoryId String
  priority   Int      @default(0)
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, keyword])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Nguồn tiền
// ─────────────────────────────────────────────────────────────────────────────

/// Nơi tiền nằm: một tài khoản ngân hàng, một thẻ tín dụng, một ví điện tử.
///
/// Chỉ là cái NHÃN — không số thẻ, không credential, không kết nối ngân hàng.
/// Tồn tại vì không có nó thì chi tiêu bằng thẻ và chi tiêu từ tài khoản bị gộp
/// làm một, và khoản trả nợ thẻ không phân biệt được với một khoản chi thật.
///
/// Được tạo tự động lúc import, người dùng chỉ sửa lại tên nếu muốn.
model Account {
  id     String @id @default(cuid())
  userId String

  name String
  kind AccountKind

  /// Khoá ổn định để lần import sau map vào đúng account đã có, thay vì đẻ ra
  /// một account mới theo từng tên file. Dạng `${bankProfile}:${kind}`.
  fingerprint String

  /// CHỈ có nghĩa với `credit_card`: dư nợ TRƯỚC giao dịch sớm nhất đã import.
  /// Mặc định 0 — thà hiện một con số thiếu phần lịch sử chưa import còn hơn
  /// bắt người dùng nhập số dư trước khi được xem bất cứ thứ gì.
  openingBalance BigInt @default(0)

  /// Ngày chốt sao kê / ngày đến hạn trong tháng, 1-31. Chỉ dùng để hiển thị kỳ
  /// và nhắc hạn, không tham gia tính toán số tiền.
  statementDay Int?
  dueDay       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  staged       StagedTransaction[]
  batches      ImportBatch[]

  @@unique([userId, fingerprint])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Giao dịch
// ─────────────────────────────────────────────────────────────────────────────

model Transaction {
  id String @id @default(cuid())

  userId     String
  categoryId String?
  /// Nguồn tiền. NULL với giao dịch nhập tay không chỉ định nguồn — thống kê
  /// coi những dòng đó như tài khoản tiền mặt.
  accountId  String?

  /// Số nguyên VND, LUÔN > 0 (CHECK constraint trong migration).
  /// Chiều thu/chi nằm ở `type`, không nằm ở dấu. Xem ADR 9.4.
  amount BigInt
  type   TxType

  /// Chiều thứ hai, độc lập với `type`: dòng này là tiền dịch chuyển giữa các
  /// nguồn của chính người dùng chứ không phải chi tiêu/thu nhập thật. NULL =
  /// giao dịch thật. Mọi query thống kê đều lọc `internalKind IS NULL`.
  internalKind InternalKind?

  /// Ngày lịch, KHÔNG phải instant — nên không có bug timezone. Xem ADR 9.5.
  date        DateTime @db.Date
  description String

  /// Số dư sau giao dịch, nếu sao kê có cột này. KHÔNG dùng cho dedupe (xem ADR
  /// 9.8) — chỉ để đối chiếu khi nghi parser đọc sai cột.
  balance BigInt?

  /// sha256(userId|date|amount|type|normalizedDesc|seq). `balance` cố tình
  /// không tham gia hash — xem ADR 9.8 và src/imports/dedupe.ts.
  dedupeHash    String
  importBatchId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account     Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([userId, dedupeHash])
  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, type, date])
  @@index([userId, accountId, date])
  /// `internalKind IS NULL` nằm trong WHERE của mọi query thống kê sau thay đổi
  /// này, nên nó phải đứng trước `type` trong index.
  @@index([userId, internalKind, type, date])
  @@index([importBatchId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Import
// ─────────────────────────────────────────────────────────────────────────────

model ImportBatch {
  id          String       @id @default(cuid())
  userId      String
  source      ImportSource
  fileName    String
  bankProfile String?
  /// Nguồn tiền suy ra từ file. Cả batch chung một account.
  accountId   String?
  /// Số dòng parse được từ file
  rowCount    Int
  status      ImportStatus @default(pending)
  createdAt   DateTime     @default(now())
  confirmedAt DateTime?

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account?            @relation(fields: [accountId], references: [id], onDelete: SetNull)
  staged       StagedTransaction[]
  transactions Transaction[]

  @@index([userId, status])
  @@index([status, createdAt])
}

/// Hàng chờ confirm.
///
/// Tồn tại vì `POST /imports` và `POST /imports/:id/confirm` là hai request khác
/// nhau, không chia sẻ bộ nhớ. Nhờ bảng này mà `Transaction` KHÔNG BAO GIỜ chứa
/// dòng chưa confirm — nên không query thống kê nào cần filter theo status.
/// Xem ADR 9.6.
model StagedTransaction {
  id      String @id @default(cuid())
  batchId String

  /// Thứ tự trong file gốc, để preview hiển thị đúng thứ tự người dùng thấy
  rowIndex Int

  categoryId String?
  accountId  String?
  amount     BigInt
  type       TxType
  date       DateTime @db.Date
  description String
  balance    BigInt?
  dedupeHash String

  internalKind InternalKind?

  duplicate DuplicateKind @default(none)
  /// User có thể bỏ tick dòng không muốn import
  selected  Boolean       @default(true)
  /// Dòng gốc từ file, để debug khi parse sai
  rawLine   String

  batch    ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  category Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account  Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([batchId, rowIndex])
}

// ─────────────────────────────────────────────────────────────────────────────
// Ngân sách
// ─────────────────────────────────────────────────────────────────────────────

model Budget {
  id         String @id @default(cuid())
  userId     String
  categoryId String
  /// Kỳ ngân sách dạng 'YYYY-MM'
  month      String
  /// Số nguyên VND, > 0
  limitAmount BigInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
  @@index([userId, month])
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum TxType {
  income
  expense
}

/// Loại nguồn tiền. Quyết định cách một dòng được diễn giải:
///
///   bank / wallet — tiền có sẵn; chi từ đây là tiền rời tài khoản ngay.
///   credit_card   — tiền đi vay; chi từ đây tính vào chi tiêu ngay tại ngày
///                   mua (dồn tích), còn tiền chỉ thật sự rời tài khoản khi
///                   thanh toán sao kê — và khoản đó là `card_payment`, không
///                   phải một khoản chi mới.
enum AccountKind {
  bank
  credit_card
  wallet
}

/// Vì sao một dòng KHÔNG phải chi tiêu/thu nhập thật, mà chỉ là tiền dịch
/// chuyển giữa các nguồn của chính người dùng.
///
/// Cố tình tách khỏi `TxType` thay vì thêm giá trị `transfer` vào đó: chiều
/// tiền vẫn cần thiết cho mọi dòng (trả nợ thẻ là tiền RA khỏi tài khoản ngân
/// hàng và tiền VÀO thẻ), và `Category.type` cũng dùng `TxType` — nhét
/// `transfer` vào enum đó sẽ kéo theo khái niệm "danh mục chuyển khoản" vô nghĩa.
///
/// KHÔNG có giá trị cho rút tiền ATM. Không có tài khoản tiền mặt để tiền chảy
/// vào, nên đánh dấu nội bộ sẽ làm khoản đó biến mất khỏi mọi thống kê.
enum InternalKind {
  /// Thanh toán sao kê thẻ tín dụng, ở cả hai vế của giao dịch.
  card_payment
  /// Nạp tiền vào ví điện tử từ tài khoản ngân hàng.
  wallet_topup
  /// Chuyển giữa hai tài khoản của chính người dùng.
  self_transfer
}

enum ImportSource {
  csv
  xlsx
  pdf
}

enum ImportStatus {
  pending
  confirmed
  rolled_back
}

/// Vì sao một dòng staged bị coi là trùng.
///
/// Cố tình KHÔNG có giá trị `in_batch`. Với cách tính hash ở ADR 9.8, mỗi dòng
/// trong cùng một batch nhận `seq` riêng nên không bao giờ trùng hash nhau — và
/// đó là hành vi đúng: hai dòng giống hệt nhau trong một file sao kê là hai giao
/// dịch thật (hai ly cà phê cùng ngày), không phải một dòng bị lặp. Trường hợp
/// file thật sự có dòng lặp do lỗi export thì không thể phân biệt được với hai
/// giao dịch thật, nên để người dùng bỏ tick ở bước preview.
enum DuplicateKind {
  none
  in_db
}
