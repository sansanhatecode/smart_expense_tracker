{
  "compilerOptions": {
    "target": "ES2022",
    // node20 thay cho commonjs + moduleResolution "node" (alias của node10, TS 7 xoá hẳn).
    // Vẫn emit CommonJS vì package.json không có "type": "module" — Nest chạy như cũ.
    "module": "node20",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": false,
    "sourceMap": true,
    // KHÔNG bật "incremental": nest-cli có deleteOutDir=true, nên dist bị xoá
    // trong khi .tsbuildinfo vẫn báo "không có gì thay đổi" → tsc không emit gì
    // và build ra một dist thiếu file, im lặng. Build đúng quan trọng hơn vài giây.
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
