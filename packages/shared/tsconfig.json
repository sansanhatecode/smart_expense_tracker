{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // Xem ghi chú ở apps/api/tsconfig.json: "node" = node10, bị xoá ở TS 7.
    "module": "node20",
    "moduleResolution": "node16",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
